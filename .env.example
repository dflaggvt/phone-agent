NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
PERSISTENCE_DRIVER=firestore
FIREBASE_PROJECT_ID=phone-agent-43313
APP_PUBLIC_BASE_URL=https://your-cloud-run-url
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=600

# Retell
RETELL_API_KEY=replace-me
RETELL_DEFAULT_AGENT_ID=agent_replace_me
RETELL_DEFAULT_FROM_NUMBER=+19145550123
RETELL_INBOUND_WEBHOOK_VERIFY=true
USER_TRANSFER_PHONE_NUMBER=+15551234567
SELF_SERVE_RETELL_PROVISIONING=false
BILLING_PLAN=beta
BILLING_MONTHLY_INCLUDED_MINUTES=300
BILLING_MONTHLY_CLASSIFICATION_LIMIT=1000
BILLING_REQUIRED_FOR_PROVISIONING=false
BILLING_DEFAULT_SPENDING_CAP_CENTS=4000

# Stripe billing
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PERSONAL_MONTHLY=price_replace_me
STRIPE_PRICE_PERSONAL_CALL_MINUTE_OVERAGE=price_replace_me

# OpenAI classification
OPENAI_API_KEY=replace-me
OPENAI_CLASSIFIER_MODEL=gpt-4.1

# Google Calendar OAuth
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT_URI=https://your-cloud-run-url/oauth/google/calendar/callback
GOOGLE_OAUTH_STATE_SECRET=replace-me-with-managed-secret
